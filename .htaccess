# SanaTec Diving — Apache configuration.
#
# ---------------------------------------------------------------------------
# READ THIS BEFORE REPLACING THIS FILE
#
# A server-wide hardening pass overwrote this file on 2026-09-18 with a generic
# template. The generic rules were good and are kept below, verbatim, under
# "shared hardening". But the template had no routing, so /es/ and /sitemap.xml
# returned 404 for five days — the entire Spanish site — and its dotfile rule
# does not actually protect .git.
#
# If a future pass overwrites this file again, the same two things break again.
# The rules under "site-specific" are not optional decoration; the site does not
# work without them. Merge, do not replace.
# ---------------------------------------------------------------------------


# ===========================================================================
# Shared hardening (from the server-wide template — keep in sync)
# ===========================================================================

# Disable directory listings and filename negotiation.
Options -Indexes -MultiViews

# Block access to hidden files such as .env, .git, and .user.ini.
# .well-known remains accessible because its contents do not begin
# with a period.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block common configuration, dependency, and diagnostic files.
<FilesMatch "(?i)^(composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|phpunit\.xml(\.dist)?|readme\.html|license\.txt|error_log)$">
    Require all denied
</FilesMatch>

# Block database dumps, logs, backups, editor files, and temporary files.
<FilesMatch "(?i)\.(bak|backup|old|orig|save|swp|swo|tmp|temp|dist|sql|sqlite|sqlite3|log|ini|conf)$">
    Require all denied
</FilesMatch>

# Prevent browsers from MIME-sniffing responses.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>


# ===========================================================================
# Site-specific — the site is broken without these
# ===========================================================================

DirectoryIndex index.php

# --- Never serve these -----------------------------------------------------

# The <FilesMatch "^\."> rule above does NOT cover this. FilesMatch tests the
# filename, and the filename in /.git/config is "config", which does not begin
# with a period. Without the line below, the whole repository — including its
# history — can be reconstructed over HTTP.
#
# 404 rather than 403, so the response does not confirm the directory exists.
RedirectMatch 404 "^/\.git(/|$)"

# Application code, templates, schema, scripts, tests and docs.
RedirectMatch 404 "^/(src|templates|db|bin|tests|docs)(/|$)"

# Local development configuration, if one is ever left behind.
RedirectMatch 404 "^/config\.local\.php$"

<FilesMatch "\.(md|log|bak|dist|ini)$">
    Require all denied
</FilesMatch>

<FilesMatch "^UPLOAD\.txt$">
    Require all denied
</FilesMatch>

# --- Routing ---------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Spanish edition. English is served from the document root.
    RewriteRule ^es/?$ index.php?lang=es [L,QSA]

    # Share links: one course or excursion first, with its own preview card.
    RewriteRule ^c/([a-z0-9-]+)/?$ index.php?lang=en&share=$1 [L,QSA]
    RewriteRule ^es/c/([a-z0-9-]+)/?$ index.php?lang=es&share=$1 [L,QSA]

    # The team, and one member's profile; their photo.
    RewriteRule ^team/?$ team.php?lang=en [L,QSA]
    RewriteRule ^es/team/?$ team.php?lang=es [L,QSA]
    RewriteRule ^team/([a-z0-9-]+)/photo\.jpg$ team-photo.php?slug=$1 [L]
    RewriteRule ^team/([a-z0-9-]+)/?$ team.php?lang=en&slug=$1 [L,QSA]
    RewriteRule ^es/team/([a-z0-9-]+)/?$ team.php?lang=es&slug=$1 [L,QSA]

    # A diver's public passport, when they have switched it on.
    RewriteRule ^passport/([a-f0-9-]+)/?$ passport.php?lang=en&id=$1 [L,QSA]
    RewriteRule ^es/passport/([a-f0-9-]+)/?$ passport.php?lang=es&id=$1 [L,QSA]

    # Generated link-preview images.
    RewriteRule ^og/([a-z0-9-]+)\.png$ og.php?f=$1 [L]

    # The privacy notice, in both languages.
    RewriteRule ^privacy/?$ privacy.php?lang=en [L,QSA]
    RewriteRule ^es/privacy/?$ privacy.php?lang=es [L,QSA]

    # The sitemap is generated, so search engines always see current content.
    # robots.txt advertises it, so a 404 here is a 404 Google is told to fetch.
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# --- Caching and compression -----------------------------------------------
<IfModule mod_headers.c>
    # The price guide images change only when prices do.
    <FilesMatch "\.(jpe?g|png|gif|svg|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/ld+json
</IfModule>
